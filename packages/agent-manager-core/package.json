{
  "name": "@wadeck-app/agent-manager-core",
  "version": "0.1.0",
  "description": "Pure model of agent-manager: the Claude Code session registry reader (M1b: registry only, no hooks, no transcripts)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "test": "vitest run --bail=1",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reply": {
      "types": "./dist/reply/index.d.ts",
      "default": "./dist/reply/index.js"
    },
    "./transcript": {
      "types": "./dist/transcript/index.d.ts",
      "default": "./dist/transcript/index.js"
    }
  }
}
