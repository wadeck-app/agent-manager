{
  "name": "@wadeck-app/app-module-agent-manager",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist-module"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "app-core-cli check .",
    "entries": "tsx src/dsl-components/build/generate-entries.ts",
    "css": "tsx src/dsl-components/build/build-css.ts",
    "bundle": "npm run entries && npm run css && app-core-cli package .",
    "test": "vitest run --bail=1",
    "test:watch": "vitest",
    "clean": "rimraf dist-module"
  },
  "dependencies": {
    "@wadeck-app/agent-manager-core": "*",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wadeck-app/app-core-cli": "latest",
    "@wadeck-app/app-core-sdk": "latest",
    "@wadeck-app/dsl-renderer": "latest",
    "@wadeck-app/dsl-ui": "latest",
    "autoprefixer": "^10.6.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
