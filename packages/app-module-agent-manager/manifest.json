{
  "id": "agent-manager",
  "title": "Agents",
  "dslLib": {
    "shared": {
      "react": "^19",
      "react-router-dom": "^7",
      "@wadeck-app/dsl-ui": ">=2026.11.8-0",
      "@wadeck-app/dsl-renderer": ">=2026.11.8-0"
    }
  },
  "extensionPoints": [
    {
      "kind": "page",
      "slot": "nav",
      "label": "Agents",
      "path": "/agents",
      "view": {
        "type": "path",
        "value": "./src/dsl-views/sessions-page.yaml"
      }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Table",
      "path": "/table",
      "view": {
        "type": "path",
        "value": "./src/dsl-views/sessions-table.yaml"
      }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Guardrails",
      "path": "/guardrails",
      "view": {
        "type": "path",
        "value": "./src/dsl-views/guardrails-page.yaml"
      }
    },
    {
      "kind": "widget",
      "slot": "dashboard",
      "label": "Agents",
      "width": 4,
      "view": {
        "type": "path",
        "value": "./src/dsl-views/sessions-widget.yaml"
      }
    }
  ]
}
